/* Calf Default */

@define-color bg #2e2e2e;
@define-color base #1a1a1a;
@define-color text #d9d9d9;

* {
  font-family: Sans;
  font-size: 8pt;
  color: #dddddd;
}

.Calf-Rack {
  background-image: url("@guidatadir@/background_rack.png");
  background-repeat: repeat;
}

.Calf-Rack-Title {
  color: #001c1c;
  font-family: "Open Sans Condensed";
  font-size: 11pt;
}

.Calf-Rack-Entry {
  font-family: "Open Sans Condensed";
  font-size: 11pt;
  background-color: #000000;
  color: #d1ea73;
}

.Calf-Label {
  color: #ffffff;
  font-size: 7pt;
}

.CalfMainLeft {
  background-image: url("@guidatadir@/side_d_w.png");
  background-repeat: no-repeat;
}
.CalfMainRight {
  background-image: url("@guidatadir@/side_d_e.png");
  background-repeat: no-repeat;
}

.Calf-Plugin {
  background-image: url("@guidatadir@/background_plugin.png");
  background-repeat: repeat;
}
.CalfPluginLeft {
  background-image: url("@guidatadir@/side_w.png");
  background-repeat: no-repeat;
}
.CalfPluginRight {
  background-image: url("@guidatadir@/side_e.png");
  background-repeat: no-repeat;
}

.Calf-Menu {
  color: #dddddd;
  background-color: #111111;
  font-size: 8pt;
}
.Calf-Menu:selected {
  color: #ffffff;
  background-color: #333333;
}

entry.Calf-Rack-Entry {
  background-color: #000000;
  color: #d1ea73;
}

.calf-button {
  font-size: 8pt;
  background-color: #d9d9d9;
  color: #001a1a;
}
.calf-button:hover { background-color: #e6e6e6; }
.calf-button:active { background-color: #f2f2f2; }

.calf-toggle-button {
  font-size: 8pt;
  background-color: #d9d9d9;
  color: #001a1a;
}

.calf-combobox {
  font-size: 8pt;
  background-color: #d9d9d9;
  color: #000000;
}

.notebook {
  color: #ffffff;
}

/* GTK4 popup menus */
popover.menu {
  color: #dddddd;
  background-color: #111111;
  background-image: url("@guidatadir@/background_menu.png");
  background-repeat: repeat;
}
popover.menu > contents {
  background-color: transparent;
}
popover.menu modelbutton {
  color: #dddddd;
}
popover.menu modelbutton:hover,
popover.menu modelbutton:focus {
  color: #ffffff;
  background-color: #333333;
}

/* GTK4: make the scrolled window viewport transparent so the
   plugin background image on the inner container is visible */
scrolledwindow.Calf-Container > viewport {
  background-color: transparent;
  background-image: none;
}
