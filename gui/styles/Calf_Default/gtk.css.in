/* Calf Default */

@define-color bg #2e2e2e;
@define-color base #1a1a1a;
@define-color text #d9d9d9;

* {
  font-family: Sans;
  font-size: 8pt;
  color: #dddddd;
}

.Calf-Rack {
  background-image: url("@guidatadir@/background_rack.png");
  background-repeat: repeat;
}

.Calf-Rack-Title {
  color: #001c1c;
  font-family: "Open Sans Condensed";
  font-size: 11pt;
}

.Calf-Rack-Entry {
  font-family: "Open Sans Condensed";
  font-size: 11pt;
  background-color: #000000;
  color: #d1ea73;
}

/* Rack widget labels (small font, grey text) */
.Calf-Rack-Widgets {
  color: #545454;
  font-size: 5pt;
}

.Calf-Rack-Label {
  color: #545454;
  font-size: 5pt;
}

.Calf-Label {
  color: #ffffff;
  font-size: 7pt;
}

/* Calf-Value uses same style as Calf-Label */
.Calf-Value {
  color: #ffffff;
  font-size: 7pt;
}

.CalfMainLeft {
  background-image: url("@guidatadir@/side_d_w.png");
  background-repeat: repeat-y;
}
.CalfMainRight {
  background-image: url("@guidatadir@/side_d_e.png");
  background-repeat: repeat-y;
}

.Calf-Plugin {
  background-image: url("@guidatadir@/background_plugin.png");
  background-repeat: repeat;
}
.CalfPluginLeft {
  background-image: url("@guidatadir@/side_w.png");
  background-repeat: no-repeat;
}
.CalfPluginRight {
  background-image: url("@guidatadir@/side_e.png");
  background-repeat: no-repeat;
}

/* Connector */
.Connector-Children {
  font-size: 8pt;
}
.Connector-Title {
  font-size: 13pt;
}

.Calf-Menu {
  color: #dddddd;
  background-color: #111111;
  font-size: 8pt;
}
.Calf-Menu:selected {
  color: #ffffff;
  background-color: #333333;
}

entry.Calf-Rack-Entry {
  background-color: #000000;
  color: #d1ea73;
}

/* Text entry */
entry.Calf-Entry {
  background-color: #000000;
  color: #d1ea73;
}
entry.Calf-Entry:selected {
  background-color: #000000;
  color: #000000;
}

.calf-button {
  font-size: 8pt;
  background-color: #d9d9d9;
  color: #001a1a;
}
.calf-button label { color: #001a1a; }
.calf-button:hover { background-color: #e6e6e6; }
.calf-button:active { background-color: #f2f2f2; }

.calf-toggle-button {
  font-size: 8pt;
  background-color: #d9d9d9;
  color: #001a1a;
}
.calf-toggle-button label { color: #001a1a; }

.calf-combobox {
  font-size: 8pt;
  background-color: #d9d9d9;
  color: #000000;
}

/* Scale / fader */
scale.Calf-Scale {
  color: #ffffff;
}
scale.Calf-Scale trough {
  background-color: #444444;
}
scale.Calf-Scale slider {
  background-color: #888888;
}

/* Notebook */
.notebook {
  color: #ffffff;
}
notebook > header > tabs > tab {
  color: #ffffff;
  background-color: #ffffff;
}
notebook > header > tabs > tab:checked {
  color: #eeeeee;
}

/* Treeview */
treeview.Calf-TreeView {
  background-color: #222932;
  color: #dddddd;
}
treeview.Calf-TreeView > row:selected,
treeview.Calf-TreeView > row:active {
  background-color: #49596a;
  color: #ffffff;
}
treeview.Calf-TreeView > row:nth-child(odd) {
  background-color: #323942;
}
treeview.Calf-TreeView button {
  background-color: #eeeeee;
  color: #ffffff;
}

/* Frame */
frame.Calf-Frame > border {
  border-color: #ffffff;
}
.Calf-Frame {
  color: #ffffff;
}

/* VUMeter */
.CalfVUMeter {
  background-color: #d9d9d9;
  color: #001c1c;
}

/* MeterScale */
.Calf-MeterScale {
  color: #ffffff;
}
.Calf-Rack .Calf-MeterScale {
  color: #545454;
}

/* LED */
.CalfLed {
  background-color: #d9d9d9;
}

/* Displays (LineGraph, PhaseGraph, Tuner, Pattern) */
.CalfLineGraph,
.CalfPhaseGraph,
.Calf-Display {
  background-color: #d9d9d9;
  color: #595a33;
}

/* Knobs — colors used by custom drawing code */
.CalfKnob {
  color: #001a1a;
}

/* GTK4 popup menus */
popover.menu {
  color: #dddddd;
  background-color: #111111;
  background-image: url("@guidatadir@/background_menu.png");
  background-repeat: repeat;
}
popover.menu > contents {
  background-color: transparent;
}
popover.menu modelbutton {
  color: #dddddd;
}
popover.menu modelbutton:hover,
popover.menu modelbutton:focus {
  color: #ffffff;
  background-color: #333333;
}

/* GTK4: make the scrolled window viewport transparent so the
   plugin background image on the inner container is visible */
scrolledwindow.Calf-Container > viewport {
  background-color: transparent;
  background-image: none;
}

/* GtkDropDown button display area */
dropdown.calf-combobox > button {
  background-image: none;
  background-color: #e3ff73;
  color: #000000;
  border-radius: 3px;
  box-shadow: none;
  padding: 2px 6px;
  min-height: 0;
}
dropdown.calf-combobox button label,
dropdown.calf-combobox button image {
  color: #000000;
}
dropdown.calf-combobox > button:hover {
  background-color: #f0ff8a;
}

/* Rack context: Calf-Label/Value match Calf-Rack-Label on the silver rack background */
.Calf-Rack .Calf-Label,
.Calf-Rack .Calf-Value {
  color: #545454;
  font-size: 5pt;
}

/* CalfFader: give GTK4 slider gizmo a valid minimum size to suppress -2 warnings */
calffader slider {
  min-width: 1px;
  min-height: 1px;
}

/* GtkPopoverMenuBar: explicitly propagate menu item text color to buttons */
popovermenubar.Calf-Menu button,
popovermenubar.Calf-Menu button label {
  color: #dddddd;
  background-color: transparent;
}
popovermenubar.Calf-Menu button:hover,
popovermenubar.Calf-Menu button:hover label {
  color: #ffffff;
  background-color: #333333;
}

