/* Calf Lost Wages */

@define-color bg #2e2e2e;
@define-color base #1a1a1a;
@define-color text #d9d9d9;

* {
  font-family: Sans;
  font-size: 8pt;
  color: #dddddd;
}

.Calf-Rack {
  background-image: url("@guidatadir@/background_plugin.png");
  background-repeat: repeat;
}

.Calf-Rack-Title {
  color: #000000;
  font-family: "Open Sans Condensed";
  font-size: 11pt;
}

.Calf-Rack-Entry {
  font-family: "Open Sans Condensed";
  font-size: 11pt;
}

/* Rack widget labels (small font, black text) */
.Calf-Rack-Widgets {
  color: #000000;
  font-size: 5pt;
}

.Calf-Rack-Label {
  color: #000000;
  font-size: 5pt;
}

.Calf-Label {
  color: #000000;
  font-size: 7pt;
}

/* Calf-Value uses same style as Calf-Label */
.Calf-Value {
  color: #000000;
  font-size: 7pt;
}

.CalfMainLeft {
  background-image: url("@guidatadir@/side_d_w.png");
  background-repeat: no-repeat;
}
.CalfMainRight {
  background-image: url("@guidatadir@/side_d_e.png");
  background-repeat: no-repeat;
}

.Calf-Plugin {
  background-image: url("@guidatadir@/background_plugin.png");
  background-repeat: repeat;
}
.CalfPluginLeft {
  background-image: url("@guidatadir@/side_w.png");
  background-repeat: no-repeat;
}
.CalfPluginRight {
  background-image: url("@guidatadir@/side_e.png");
  background-repeat: no-repeat;
}

/* Connector */
.Connector-Children {
  font-size: 8pt;
}
.Connector-Title {
  font-size: 13pt;
}

.Calf-Menu {
  color: #dddddd;
  background-color: #111111;
  font-size: 8pt;
}
.Calf-Menu:selected {
  color: #ffffff;
  background-color: #333333;
}

entry.Calf-Rack-Entry {
  background-color: #000000;
  color: #ff67cb;
}

/* Text entry — RC: text[NORMAL]=#ff67cb, base[NORMAL]=#000 */
entry.Calf-Entry {
  background-color: #000000;
  color: #ff67cb;
}
entry.Calf-Entry:selected {
  background-color: #ff67cb;
  color: #000000;
}

.calf-button {
  font-size: 8pt;
  background-color: #000000;
  color: #ffffff;
}
.calf-button:hover { background-color: #1a1a1a; }
.calf-button:active { background-color: #2d2d2d; }

.calf-toggle-button {
  font-size: 8pt;
  background-color: #000000;
  color: #ffffff;
}

.calf-combobox {
  font-size: 8pt;
  background-color: #000000;
  color: #000000;
}

/* Scale / fader */
scale.Calf-Scale {
  color: #000000;
}
scale.Calf-Scale trough {
  background-color: #555555;
}
scale.Calf-Scale slider {
  background-color: #888888;
}

/* Notebook */
.notebook {
  color: #000000;
}
notebook > header > tabs > tab {
  color: #000000;
  background-color: #ff67cb;
}
notebook > header > tabs > tab:checked {
  color: #000000;
}

/* Treeview */
treeview.Calf-TreeView {
  background-color: #333333;
  color: #dddddd;
}
treeview.Calf-TreeView > row:selected,
treeview.Calf-TreeView > row:active {
  background-color: #ff67cb;
  color: #000000;
}
treeview.Calf-TreeView > row:nth-child(odd) {
  background-color: #222222;
}
treeview.Calf-TreeView button {
  background-color: #eeeeee;
  color: #000000;
}

/* Frame */
frame.Calf-Frame > border {
  border-color: #000000;
}
.Calf-Frame {
  color: #000000;
}

/* VUMeter */
.CalfVUMeter {
  background-color: #000000;
  color: #ffffff;
}

/* MeterScale */
.CalfMeterScale {
  color: #000000;
}
.Calf-Rack .CalfMeterScale {
  color: #000000;
}

/* LED */
.CalfLed {
  background-color: #000000;
}

/* Displays (LineGraph, PhaseGraph, Tuner, Pattern) */
.CalfLineGraph,
.CalfPhaseGraph,
.Calf-Display {
  background-color: #000000;
  color: #56003b;
}

/* Knobs — colors used by custom drawing code */
/* fg[NORMAL]=#56003b (ring unlit), fg[PRELIGHT]=#ff67cb (ring lit), fg[ACTIVE]=black (tick) */
.CalfKnob {
  color: #56003b;
}

/* GTK4 popup menus */
popover.menu {
  color: #dddddd;
  background-color: #111111;
  background-image: url("@guidatadir@/background_menu.png");
  background-repeat: repeat;
}
popover.menu > contents {
  background-color: transparent;
}
popover.menu modelbutton {
  color: #dddddd;
}
popover.menu modelbutton:hover,
popover.menu modelbutton:focus {
  color: #ffffff;
  background-color: #333333;
}

/* GTK4: make the scrolled window viewport transparent so the
   plugin background image on the inner container is visible */
scrolledwindow.Calf-Container > viewport {
  background-color: transparent;
  background-image: none;
}

/* Rack title: match GTK2 entry appearance */
label.Calf-Rack-Title {
  background-color: #000000;
  color: #ff67cb;
  padding: 3px 7px;
}

/* GtkDropDown button display area */
dropdown.calf-combobox > button {
  background-image: none;
  background-color: #ff67cb;
  color: #000000;
  border-radius: 5px;
  box-shadow: none;
  padding: 2px 6px;
  min-height: 0;
}
dropdown.calf-combobox > button > box > label {
  color: #000000;
}
dropdown.calf-combobox > button:hover {
  background-color: #ff88d8;
}
